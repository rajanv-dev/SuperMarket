# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to Git.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Supabase PostgreSQL Database ─────────────────────────────────────────────
# Required: Supabase Project URL and Service / Secret Key or Publishable Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Payment (Simulated / Razorpay) ───────────────────────────────────────────
# Set PAYMENT_PROVIDER=razorpay to switch from the simulated provider
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Staff Management & QR Attendance System ──────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
STAFF_QR_SECRET=REPLACE_WITH_SECURE_QR_HMAC_SECRET

# ── Seed Admin ────────────────────────────────────────────────────────────────
# Used only by the seed script — never hardcode production credentials here
SEED_ADMIN_EMAIL=admin@super.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Super Admin

# ── n8n WhatsApp Order Confirmation Webhook ──────────────────────────────────
# The webhook URL triggered on order placement (HTTP POST)
N8N_ORDER_WEBHOOK_URL=https://rajanv2907.app.n8n.cloud/webhook/vrk-order-confirmation
N8N_WEBHOOK_TIMEOUT_MS=8000
# Authentication options (Header Auth or Basic Auth):
# N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here (Sent as X-Webhook-Secret header)
# N8N_WEBHOOK_USER=your_webhook_user
# N8N_WEBHOOK_PASSWORD=your_webhook_password
# N8N_WEBHOOK_BASIC_AUTH=Basic <base64_credentials>
# N8N_WEBHOOK_BEARER_TOKEN=your_token

# ── Internal Microservices & Automation API Key ──────────────────────────────
# Optional secret key required by GET /api/internal/orders/:id (via x-api-key)
# INTERNAL_API_KEY=your_internal_service_key_here

