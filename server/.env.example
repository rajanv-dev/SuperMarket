# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to Git.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/super
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/super
MONGO_URI=mongodb://localhost:27017/super

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://dpdfgequagdyiktlresv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_JD2lpTCRtUlKdD0k-EgP5w_xk7Q2abS
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_JWKS_URL=https://dpdfgequagdyiktlresv.supabase.co/auth/v1/.well-known/jwks.json

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Payment (Simulated / Razorpay) ───────────────────────────────────────────
# Set PAYMENT_PROVIDER=razorpay to switch from the simulated provider
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Seed Admin ────────────────────────────────────────────────────────────────
# Used only by the seed script — never hardcode production credentials here
SEED_ADMIN_EMAIL=admin@super.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Super Admin
